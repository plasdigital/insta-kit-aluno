# .env.exemplo — copie para .env.local e preencha.
#
# O .env.local NUNCA vai para o Git (o .gitignore já barra). Token de Instagram vale 60 dias e
# dá acesso de publicação à sua conta: trate como senha.

# ---------------------------------------------------------------------------
# AS CONTAS
# ---------------------------------------------------------------------------
# O rótulo (TESTE, PRINCIPAL) é você quem inventa, e é o que vai na linha de comando:
#     node perfil.mjs TESTE
#     node publicar/publicar.mjs foto capa.jpg PRINCIPAL --confirmar
#
# Conta nova = três linhas novas com outro rótulo. Não há limite.

IG_TESTE_USER_ID=
IG_TESTE_TOKEN=
IG_TESTE_TOKEN_EXPIRA=

IG_PRINCIPAL_USER_ID=
IG_PRINCIPAL_TOKEN=
IG_PRINCIPAL_TOKEN_EXPIRA=

# A conta usada quando você esquece o rótulo. Aponte para a de TESTE: assim o esquecimento
# erra em favor do laboratório, não do perfil que tem audiência.
IG_CONTA_PADRAO=TESTE

# ---------------------------------------------------------------------------
# O APP NA META
# ---------------------------------------------------------------------------
# Da tela do app em developers.facebook.com.
# ATENÇÃO: o "Instagram app secret" é DIFERENTE do "App secret" do Facebook, e não são
# intercambiáveis. Nenhum script aqui precisa deles hoje; servem para validar assinatura de
# webhook e rodar debug_token.

IG_APP_ID=
IG_APP_SECRET=

# ---------------------------------------------------------------------------
# SUPABASE — hospedagem da mídia e tabela da DM
# ---------------------------------------------------------------------------
# Necessário para publicar ARQUIVO LOCAL: a API da Meta não aceita upload, só URL pública.
# Se você só publica de URL e não usa o agente de DM, pode deixar tudo em branco.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Modo publicador — use ISTO em servidor, no lugar da service_role acima.
# É um usuário comum, com policies só no bucket `instagram`. Se estas três estiverem
# preenchidas, o hospedar.mjs entra por elas; se faltar uma, ele volta para a service_role
# SEM AVISAR. Confira o modo que ele imprime ao subir o arquivo.
SUPABASE_ANON_KEY=
IG_STORAGE_EMAIL=
IG_STORAGE_SENHA=

# Conexão direta com o Postgres — usada só por agente-dm/precarga.mjs, uma vez.
DATABASE_URL=

# ---------------------------------------------------------------------------
# BOLETIM SEMANAL (opcional)
# ---------------------------------------------------------------------------
# O webhook do n8n que recebe o boletim e manda o e-mail.
# A chave existe porque webhook aberto que dispara e-mail é um disparador de spam com o seu nome.

BOLETIM_WEBHOOK_URL=
BOLETIM_WEBHOOK_CHAVE=

# ---------------------------------------------------------------------------
# TELEGRAM (opcional — aprovação de resposta a comentário)
# ---------------------------------------------------------------------------
# Crie o bot com o @BotFather. O chat_id é o da sua conversa com ele.

TELEGRAM_AVISOS_BOT_TOKEN=
TELEGRAM_AVISOS_CHAT_ID=
