      "parameters": {
        "jsCode": "// O envio da DM falhou: solta a marca para que a pessoa possa ser atendida\n// numa proxima tentativa (ela ainda tem 7 dias de janela a partir do comentario).\nconst store = $getWorkflowStaticData('global');\nstore.atendidos = store.atendidos || {};\nconst c = $('Set Comments').first().json;\ndelete store.atendidos[c.post_id + ':' + c.from_id];\nreturn items;"
      },
