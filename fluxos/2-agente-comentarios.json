    {
      "parameters": {
        "jsCode": "// Acessa o primeiro item e a variável específica\nconst inputData = $input.first().json.comment_reply;\n\n// Verifica se a variável existe e é uma string antes de dar o split\nif (inputData && typeof inputData === 'string') {\n  const partes = inputData.split('\\n\\n');\n\n  // Retorna cada parte como um novo item para o n8n\n  return partes.map(parte => {\n    return {\n      json: {\n        texto_split: parte.trim() // trim() remove espaços extras ou quebras sobressalentes\n      }\n    };\n  });\n}\n\n// Caso não exista o conteúdo, retorna um array vazio ou o item original\nreturn [];"
      },
