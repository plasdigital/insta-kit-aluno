      "parameters": {
        "jsCode": "// Nao manda a mesma DM duas vezes para a mesma pessoa no mesmo post.\n// Guarda o par post:pessoa no staticData do workflow (persiste so em execucao de producao).\nconst store = $getWorkflowStaticData('global');\nstore.atendidos = store.atendidos || {};\n\nconst agora = Date.now();\nconst TRINTA_DIAS = 30 * 24 * 60 * 60 * 1000;\nfor (const [k, t] of Object.entries(store.atendidos)) {\n  if (agora - t > TRINTA_DIAS) delete store.atendidos[k];\n}\n\nconst c = $('Set Comments').first().json;\nconst chave = c.post_id + ':' + c.from_id;\n\nif (store.atendidos[chave]) return [];\nstore.atendidos[chave] = agora;\nreturn items;"
      },
