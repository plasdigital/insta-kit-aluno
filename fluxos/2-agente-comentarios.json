    {
      "parameters": {
        "jsCode": "// Substitui o par \"If2 + Filtra Key Word\": em vez de FILTRAR (e matar o ramo em silencio),\n// MARCA. Sempre devolve 1 item, para que o comentario que nao bate no gatilho siga para a IA.\n// Foi assim que o comentario do @sergioluiscs se perdeu em 25/ago/2026: o ramo morria calado.\n//\n// Camadas do gatilho:\n//   1. EXATO normalizado  — acento, maiuscula, emoji e pontuacao nao importam\n//   2. ERRO DE DIGITACAO  — distancia de edicao: ate 3 letras exato | 4-7: 1 erro | 8+: 2 erros\n//   3. INTENCAO           — nao e aqui: quem faz e o classificador, que recebe a key_word no prompt\n\nconst normaliza = (s) => (s || '')\n  .toString()\n  .normalize('NFD')\n  .replace(/[\\u0300-\\u036f]/g, '')\n  .toLowerCase()\n  .replace(/[^a-z0-9]+/g, ' ')\n  .trim();\n\nfunction distancia(a, b, limite) {\n  if (Math.abs(a.length - b.length) > limite) return limite + 1;\n  const linha = Array.from({ length: b.length + 1 }, (_, i) => i);\n  for (let i = 1; i <= a.length; i++) {\n    let anterior = linha[0];\n    linha[0] = i;\n    let melhor = linha[0];\n    for (let j = 1; j <= b.length; j++) {\n      const troca = anterior + (a[i - 1] === b[j - 1] ? 0 : 1);\n      anterior = linha[j];\n      linha[j] = Math.min(linha[j] + 1, linha[j - 1] + 1, troca);\n      if (linha[j] < melhor) melhor = linha[j];\n    }\n    if (melhor > limite) return limite + 1;\n  }\n  return linha[b.length];\n}\n\nconst tolerancia = (n) => (n <= 3 ? 0 : n <= 7 ? 1 : 2);\n\nconst c = $('Set Comments').first().json;\nconst palavras = normaliza(c.comment_text).split(' ').filter(Boolean);\n\n// Get Post esta com \"Always Output Data\": sem linha na tabela, chega um item vazio em vez de nada.\nconst linha = (items[0] && items[0].json && items[0].json.post_id) ? items[0].json : {};\n\nfunction bate(chave) {\n  if (!chave) return false;\n  const alvo = chave.split(' ').filter(Boolean);\n  if (!alvo.length) return false;\n  const limite = tolerancia(chave.replace(/ /g, '').length);\n  for (let i = 0; i + alvo.length <= palavras.length; i++) {\n    const janela = palavras.slice(i, i + alvo.length).join(' ');\n    if (janela === chave) return true;\n    if (limite && distancia(janela, chave, limite) <= limite) return true;\n  }\n  return false;\n}\n\nconst key_word = linha.key_word || '';\nconst direct_message = linha.direct_message || '';\n\nreturn [{\n  json: {\n    ...c,\n    key_word,\n    direct_message,\n    comment_reply: linha.comment_reply || '',\n    tem_linha: Boolean(linha.post_id),\n    // so e gatilho de verdade se a linha tiver AS DUAS coisas: a palavra e a mensagem a enviar\n    bateu: Boolean(key_word && direct_message && bate(normaliza(key_word))),\n  },\n}];\n"
      },
